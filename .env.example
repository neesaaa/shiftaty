# ===== Database =====
POSTGRES_DB=shiftaty
POSTGRES_USER=shiftaty
POSTGRES_PASSWORD=shiftaty

# ===== Backend =====
ASPNETCORE_ENVIRONMENT=Production

# JWT — CHANGE THIS to a random string of at least 32 characters in production
JWT_SECRET=CHANGE_ME_super_secret_key_at_least_32_chars_long_please_1234567890
JWT_ISSUER=Shiftaty
JWT_AUDIENCE=ShiftatyUsers

# ===== OTP =====
# When true, the verification code is returned in API responses / logs (no email needed).
# Set to false once SMTP is configured for real email delivery.
OTP_DEV_MODE=true

# ===== SMTP (email) =====
# Leave SMTP_ENABLED=false to use dev OTP mode. When you have real credentials,
# set SMTP_ENABLED=true and fill the values below. NEVER commit real passwords.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@shiftaty.local
SMTP_FROM_NAME=Shiftaty

# ===== Admin seed account =====
ADMIN_EMAIL=nassar@gmail.com
ADMIN_PASSWORD=Admin@123456

# ===== Coin economy =====
TRIAL_COINS=100
